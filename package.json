{
  "name": "meeting-minutes-app",
  "version": "2.8.4",
  "author": {
    "name": "lester2pastm",
    "email": "25032501+lester2pastm@users.noreply.github.com"
  },
  "description": "自动会议纪要桌面应用",
  "homepage": "https://github.com/lester2pastm/auto-meeting-recorder",
  "main": "electron/main.js",
  "scripts": {
    "prepare:local-asr": "node scripts/prepare-local-asr.js",
    "prestart": "npm run prepare:local-asr",
    "start": "electron .",
    "predev": "npm run prepare:local-asr",
    "dev": "electron . --dev",
    "dev:win": "echo 'Switch to Windows environment first: npm run use:win' && exit 1",
    "predev:linux": "npm run prepare:local-asr",
    "dev:linux": "electron . --dev",
    "use:win": "node scripts/use-win.js",
    "use:linux": "node scripts/use-linux.js",
    "install:win": "node scripts/use-win.js && npm install",
    "install:linux": "node scripts/use-linux.js && npm install",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:local-asr": "npm run prepare:local-asr && node tests/integration/local-asr-runtime.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.7.0",
    "jest": "^24.9.0",
    "jest-environment-jsdom": "^24.9.0",
    "playwright": "^1.58.1",
    "png2icons": "^2.0.1",
    "serve": "^14.2.5"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.12",
    "js-yaml": "4.1.1",
    "semver": "7.7.4",
    "sherpa-onnx-node": "2.0.1"
  },
  "build": {
    "beforePack": "./scripts/prepare-local-asr.js",
    "asarUnpack": [
      "electron/local-asr-worker.js",
      "node_modules/sherpa-onnx-*/**/*"
    ],
    "appId": "com.meetingminutes.app",
    "productName": "AutoMeetingRecorder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "assets/**/*",
      "!assets/local-asr/**/*"
    ],
    "icon": "assets/icons/icon.png",
    "extraResources": [
      {
        "from": "audio_files",
        "to": "audio_files"
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [{ "from": "assets/local-asr/x-asr", "to": "local-asr/x-asr" }],
      "artifactName": "${productName}-${version}-win.${ext}"
    },
    "mac": {
      "target": "dmg",
      "publish": null,
      "artifactName": "${productName}-${version}-mac.${ext}"
    },
    "linux": {
      "extraResources": [{ "from": "assets/local-asr/x-asr", "to": "local-asr/x-asr" }],
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Office"
    },
    "deb": {
      "publish": null
    },
    "publish": {
      "provider": "github",
      "owner": "lester2pastm",
      "repo": "auto-meeting-recorder"
    }
  }
}
